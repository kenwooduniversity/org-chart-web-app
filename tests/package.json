{
  "name": "kenwood-platform-tests",
  "private": true,
  "description": "Security-rules and browser tests for the Kenwood platform, run against the Firebase emulators.",
  "type": "module",
  "scripts": {
    "test": "firebase emulators:exec --config ../firebase.json --only firestore --project kenwood-platform \"node --test rules.test.mjs\"",
    "e2e": "firebase emulators:exec --config ../firebase.json --only firestore,auth --project kenwood-platform \"node e2e.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "12.19.0",
    "firebase-tools": "^15.30.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.1",
    "playwright-core": "^1.63.0"
  }
}
